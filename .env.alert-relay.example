# Copy to a protected environment file; keep credentials in mounted files.
ALERT_RELAY_HOST=127.0.0.1
ALERT_RELAY_PORT=4312
ALERT_RELAY_TOKEN_FILE=/run/secrets/alertmanager_webhook_token
ALERT_CLOUD_URL=https://monitoring-cloud.example.com
ALERT_CLOUD_TOKEN_FILE=/run/secrets/site_agent_cloud_token
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_QUEUE_DIR=/var/lib/aiops-alert-relay/queue
ALERT_SNAPSHOT_INTERVAL_MS=60000
ALERT_WORKER_INTERVAL_MS=1000
ALERT_CLOUD_TIMEOUT_MS=10000
ALERT_QUEUE_MAX_ENTRIES=10000
ALERT_QUEUE_MAX_BYTES=268435456
