# Local monitoring API exposed by the persistent site service.
SITE_AGENT_LOCAL_URL=http://127.0.0.1:4310

# Cloud ingestion API. Port 4311 is for the local end-to-end simulator only.
SITE_AGENT_CLOUD_URL=http://127.0.0.1:4311

# Replace with the credential assigned to this source. Never commit the real value.
SITE_AGENT_TOKEN=replace-with-at-least-16-characters

# Optional one-shot controls.
# SITE_AGENT_SEQUENCE=1
# SITE_AGENT_TIMEOUT_MS=15000
# SITE_AGENT_PAGE_SIZE=200
