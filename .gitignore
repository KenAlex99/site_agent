# Real environment files
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and generated files
node_modules/
coverage/
dist/
*.log

# Secrets
*.key
*.pem
id_rsa*
*credential*
*secret*

# Archives and backups
*.tar.gz
*.tgz
*.zip
backups/

# Deployment files are local by default; only reviewed examples are tracked.
deploy/*
!deploy/examples/
deploy/examples/*
!deploy/examples/nginx/
deploy/examples/nginx/*
!deploy/examples/nginx/*.example
!deploy/examples/nginx/README.md

# Local agent configuration
.claude/

# Operating system files
.DS_Store
Thumbs.db
npm-debug.log*
